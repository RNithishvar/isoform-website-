# Copy this file to .env and fill it in. Never commit .env.

# Public address of the live site, no trailing slash (used for canonical links,
# the social preview image and sitemap.xml). Example: https://www.example.com
SITE_URL=

# Email service that delivers contact-form enquiries to the studio inbox (SMTP).
# With Gmail: turn on 2-Step Verification, create an "App password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Inbox that receives enquiries (default: isoformagency@gmail.com)
CONTACT_TO=
# Optional. "From" address (default: SMTP_USER)
MAIL_FROM=

# Local testing only: print enquiries in the terminal instead of sending them.
# Ignored in production.
# MAIL_TRANSPORT=log
